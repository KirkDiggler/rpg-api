# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Locally built binaries committed by accident at the repo root (rpg-api#712:
# `server`/`client` are `go build ./cmd/server`/`./cmd/client` run from the
# repo root instead of the Makefile's `bin/rpg-api` target; `rpg-api`/
# `rpg-client` are the same builds under alternate output names). Root-
# anchored so this never shadows the real cmd/server, cmd/client packages.
/server
/client
/rpg-api
/rpg-client

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Generated code
gen/
scripts/test-grpc-web.html
dump.rdb

# Worktrees
.worktrees/
.claude/

# scripts/toolkit-local-override.sh's synced rpg-toolkit source (see
# docs/how-to/local-toolkit-override.md) — never committed, regenerated by
# the script's `on` subcommand from a local rpg-toolkit checkout.
/local-toolkit/
